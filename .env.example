# Copy this file to .env and fill in your keys. NEVER commit .env to GitHub.

# Free key: https://serpapi.com/users/sign_up?plan=free  (250 searches/month)
SERPAPI_KEY=your_serpapi_key_here

# Any OpenAI-compatible LLM. Default: Google Gemini free tier (https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_key_here
LLM_MODEL=gemini-2.5-flash

# Other options:
# OpenAI:  LLM_BASE_URL=   (leave empty)            LLM_MODEL=gpt-4o-mini
# Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama   LLM_MODEL=llama3.1

CACHE_PATH=serp_cache.sqlite
